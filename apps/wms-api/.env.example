# Database
DB_WRITE_URL=postgresql://wms_user:wms_password@localhost:5432/wms_db
DB_READ_URL=postgresql://wms_user:wms_password@localhost:5432/wms_db

# Redis
REDIS_URL=redis://localhost:6379

# AWS / LocalStack
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_ALERT_EVENTS_URL=http://localhost:4566/000000000000/Alert-Events

# Email (AWS SES)
# In dev, LocalStack handles SES — set AWS_ENDPOINT_URL above
# In production, verify SES_FROM_EMAIL in AWS SES console first
SES_FROM_EMAIL=alerts@sumosave.com
SES_REGION=ap-south-1

# SMS (AWS SNS)
SNS_REGION=ap-south-1

# Vendor Portal URL (used in email CTAs)
PORTAL_URL=http://localhost:3001

# Security
JWT_SECRET=super-secret-dev-key
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GSP Integration
GSP_BASE_URL=https://gsp.adaequare.com
WMS_GSTIN=27AAAAA0000A1Z5
GSP_AUTH_TOKEN=test-token
